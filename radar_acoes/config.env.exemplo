# Copie este arquivo para config.env (mesma pasta) e preencha. O config.env NÃO vai para o GitHub.

# Valor do aporte mensal (R$) para a sugestão de compra no alerta diário
APORTE_MENSAL=1000

# --- Alerta no Telegram (recomendado: chega no celular) ---
# 1) No Telegram, fale com @BotFather -> /newbot -> copie o token
# 2) Mande qualquer mensagem para o seu bot e abra https://api.telegram.org/bot<TOKEN>/getUpdates
#    para ver o "chat":{"id": ...}
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alerta por e-mail (Gmail: use uma "senha de app", não a senha normal) ---
EMAIL_REMETENTE=
EMAIL_SENHA=
EMAIL_DESTINO=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORTA=465

# --- AURUM com inteligência artificial (opcional) ---
# Sem chave, o AURUM funciona no modo local (regras, grátis). Com a chave, ele escreve o relatório
# com a IA Claude, pesquisa notícias na internet sobre as ações do plano e conversa livremente no painel.
# Crie a chave em console.anthropic.com (é cobrado por uso: centavos de dólar por relatório/pergunta).
ANTHROPIC_API_KEY=
# AURUM_MODELO=claude-opus-5-5
# Intervalo da vigilância durante o pregão, em minutos (agente.py)
# AURUM_INTERVALO_MIN=30
